{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/**/*.test.ts",
    "dev/**/*.test.ts",
    "dev/gallery.ts",
    "dev/lab.ts",
    "dev/dashboard.ts",
    "dev/scenarios/*.ts",
    "api/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "dev/**/*.ts", "api/**/*.ts"],
  "rules": { "types": "off" }
}
